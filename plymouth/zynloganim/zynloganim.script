Window.SetBackgroundTopColor(0.00, 0.00, 0.00);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.00);

progress = 0;
framehold = 3;
sourceframes = 42;
numberofframes = sourceframes;
images = [];
sprite = Sprite();

for (i = 0; i < sourceframes; i++)
{
  images[i] = Image("frame-" + i + ".png");
}

sprite.SetX(Window.GetWidth() / 2 - images[0].GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - images[0].GetHeight() / 2);

fun refresh_callback()
{
  sprite.SetImage(images[Math.Int(progress / framehold) % numberofframes]);
  progress++;
}

Plymouth.SetRefreshFunction(refresh_callback);

# Messages (plymouth display-message), e.g. software update progress
message_sprite = Sprite();
message_sprite.SetZ(10);

fun message_callback(text)
{
  message_image = Image.Text(text, 1, 1, 1);
  message_sprite.SetImage(message_image);
  message_sprite.SetX(Window.GetWidth() / 2 - message_image.GetWidth() / 2);
  message_sprite.SetY(Window.GetHeight() / 2 + images[0].GetHeight() / 2 + message_image.GetHeight());
}

fun hide_message_callback(text)
{
  message_sprite.SetImage(Image.Text("", 1, 1, 1));
}

Plymouth.SetMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
