<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <libinput>
    <device>
      <touch deviceName="" mapToOutput="DSI-1" calibrationMatrix="-1 0 1 0 -1 1" />
    </device>
  </libinput>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no" />
  </windowRules>
  <keybind key="A-W-h">
    <action name="HideCursor" />
    <action name="WarpCursor" x="-1" y="-1" />
  </keybind>
</labwc_config>

